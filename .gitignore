.env
.env.*
!.env.example
node_modules/
.venv/
__pycache__/
dist/
data/raw/
data/out/
# Glob, not a single filename: login writes storageState.json (parknyc)
# AND storageState.passport.json — both are live session cookies.
executor/storageState*.json
# Recording-harness output (HARs, traces, raw page snapshots) and runtime
# unexpected-screen captures — real account data, never committed.
executor/fixtures/
executor/captures/
*.log
.DS_Store
.claude/settings.local.json
ios/**/xcuserdata/
ios/**/DerivedData/
# xcodebuild output (result bundles, screenshots) from local runs.
ios/build/

# Generated by `xcodegen generate` from ios/project.yml — never commit, never hand-edit.
ios/ParkAgent.xcodeproj/
ios/ParkAgent/Info.plist
ios/ParkAgent/ParkAgent.entitlements

# Local build config; copy from Config.example.xcconfig.
ios/Config.xcconfig

# nightly FR run artifacts (generated by fr/report.mjs in CI)
server/fr-report.json
server/fr-summary.md
