DATABASE_URL=postgresql://user:pass@your-neon-host/parkagent?sslmode=require
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Optional: the financial account the Issuing cards draw from (fa_…).
# Discovered from an existing card when unset.
# STRIPE_FINANCIAL_ACCOUNT=fa_replace_me
# Optional: Global Payouts recipient for POST /card/funding/withdraw.
# Unset → withdrawals answer funding_unavailable.
# STRIPE_PAYOUT_RECIPIENT=acct_replace_me
SOCRATA_APP_TOKEN=replace_me
# Contents of the APNs .p8 auth key. In .env, quote it and use \n for the
# line breaks; on Fly: fly secrets set -a parkagent-api APNS_KEY="$(cat AuthKey_XXXXXXXXXX.p8)"
APNS_KEY="-----BEGIN PRIVATE KEY-----\nreplace_me\n-----END PRIVATE KEY-----"
APNS_KEY_ID=replace_me
APNS_TEAM_ID=replace_me
APNS_BUNDLE_ID=com.yourname.parkagent

# Sign in with Apple token revocation (App Store 5.1.1(v)): a key from
# developer.apple.com -> Keys with "Sign in with Apple" enabled. Signs the
# client secret for Apple's /auth/token and /auth/revoke, so DELETE /me can
# revoke the user's Apple tokens. Optional as a set of three; without it
# sign-in works and no Apple token is stored or revoked.
# APPLE_SIGNIN_KEY="-----BEGIN PRIVATE KEY-----\nreplace_me\n-----END PRIVATE KEY-----"
# APPLE_SIGNIN_KEY_ID=replace_me
# APPLE_SIGNIN_TEAM_ID=replace_me
DRY_RUN=true
# Whether the ParkAgent Issuing card may be chosen as a payment source
# (PUT /me/payment-source). Default false → onboarding/Settings show it as
# "coming soon"; the default source is the card on the user's provider
# account (provider_card). Flip to true only once Issuing is live.
#ISSUING_LIVE=false
# Server-side pepper for api-key hashing (users.api_key_hash). Required.
# API keys are the admin/script credential now; the app signs users in.
# Generate:  openssl rand -base64 32
# On Fly:    fly secrets set -a parkagent-api API_KEY_PEPPER="$(openssl rand -base64 32)"
# Changing it invalidates every issued key (re-run create:user).
API_KEY_PEPPER=replace_me_random_string
# Signs the 15-minute access JWTs and peppers refresh-token hashes.
# Required, at least 32 characters.
# Generate:  openssl rand -base64 32
# On Fly:    fly secrets set -a parkagent-api AUTH_JWT_SECRET="$(openssl rand -base64 32)"
# Changing it signs everyone out (they sign in again); nothing else breaks.
AUTH_JWT_SECRET=replace_me_32_chars_minimum
# Sign in with Apple audience — the app's bundle id. Must match the App ID
# that has the Sign in with Apple capability enabled.
#APPLE_AUDIENCE=com.thomasbardhi.parkagent
# Sign in with Apple is the only method on by default. Email codes stay
# off (403 email_signin_disabled, and no button in the app) until
# EMAIL_SIGNIN_ENABLED=true, which then requires RESEND_API_KEY — the
# server refuses to boot with the switch on and no key. RESEND_FROM's
# domain must be verified in Resend AND registered with Apple's private
# email relay, or codes to @privaterelay.appleid.com addresses bounce.
#EMAIL_SIGNIN_ENABLED=false
#RESEND_API_KEY=re_replace_me
#RESEND_FROM=ParkAgent <sign-in@yourdomain.com>
# Google Sign-In. Off by default; when true, GOOGLE_CLIENT_ID is required
# (the audience every Google ID token must carry) and the server refuses
# to boot without it. The App Store requires offering Sign in with Apple
# wherever Google is offered — which we do either way.
#GOOGLE_SIGNIN_ENABLED=false
#GOOGLE_CLIENT_ID=replace_me.apps.googleusercontent.com
# The assistant's Claude access; without the key /assistant/* answers 503.
# ASSISTANT_MODEL runs the tool loop (falls back to the legacy
# ANTHROPIC_MODEL, then claude-sonnet-5); EXPLAIN_MODEL phrases
# explain_decision output (default claude-haiku-4-5-20251001).
# ASSISTANT_DAILY_SPEND_CAP_USD caps each user's estimated daily model
# spend (default 5; over the cap → 429).
#ANTHROPIC_API_KEY=sk-ant-replace_me
#ASSISTANT_MODEL=claude-sonnet-5
#EXPLAIN_MODEL=claude-haiku-4-5-20251001
#ASSISTANT_DAILY_SPEND_CAP_USD=5
# ParkWhiz — the second garage source, a read-only public search (no
# credentials needed; verified 2026-09-23). Flip false for SpotHero only.
#PARKWHIZ_ENABLED=true
# Seals linked provider session state (provider_accounts.state_encrypted).
# Generate:  openssl rand -base64 32
# On Fly:    fly secrets set -a parkagent-api PROVIDER_STATE_KEY="$(openssl rand -base64 32)"
# Unset → provider linking answers 503 and real executor calls fail typed.
#PROVIDER_STATE_KEY=replace_me_32_bytes_base64
# Plate to park when a session doesn't name one (else ParkNYC's first saved
# vehicle is used).
#PARKNYC_PLATE=ABC1234
# Optional: where executor unexpected-screen evidence is also written as files.
#EXECUTOR_CAPTURE_DIR=/tmp/parkagent-captures
# Optional: save every step of a real Passport (ParkBoston) flow as fixture
# screens under here — for verification runs; off by default.
#EXECUTOR_STEP_CAPTURE_DIR=/tmp/parkagent-steps
# Link wallet for agents (Stripe agentic commerce). All four or none; any
# missing → /link/* answers 503. Optional LINK_TEST_MODE keeps it in sandbox.
#LINK_CLIENT_ID=replace_me
#LINK_CLIENT_SECRET=replace_me
#LINK_PUBLISHABLE_KEY=pk_replace_me
#LINK_REDIRECT_URI=https://parkagent-api.fly.dev/link/callback
#LINK_TEST_MODE=true
# Optional: LLM recovery hook for unexpected ParkNYC screens (stubbed, off).
#EXECUTOR_LLM_RECOVERY=false
# Optional: how many provider browser calls run at once (1–8; default 2 —
# sized for the 1 GB Fly machine), and whether Chromium starts at boot so
# the first link after a deploy isn't a cold start (default true; needs
# PROVIDER_STATE_KEY).
#EXECUTOR_CONCURRENCY=2
#EXECUTOR_WARM_AT_BOOT=true
# Optional: how many provider browser calls run at once (1–8; default 2 —
# sized for the 1 GB Fly machine), and whether Chromium starts at boot so
# the first link after a deploy isn't a cold start (default true; needs
# PROVIDER_STATE_KEY).
#EXECUTOR_CONCURRENCY=2
#EXECUTOR_WARM_AT_BOOT=true
