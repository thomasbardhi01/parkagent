// Copy to Config.xcconfig (gitignored) and fill in.
//
//   cp ios/Config.example.xcconfig ios/Config.xcconfig
//
// DEVELOPMENT_TEAM is your 10-character Apple Developer Team ID, found in the
// vault or at developer.apple.com -> Membership. Leave it empty to build for
// the simulator with CODE_SIGNING_ALLOWED=NO; it is required to run on a phone.
DEVELOPMENT_TEAM =

// Where the app looks for the API. Note that xcconfig treats // as a comment,
// so the scheme's slashes are escaped as $() to keep the URL intact.
API_BASE_URL = http:$()/$()/localhost:3000

// No API key here any more: the app signs in as a user (Sign in with Apple
// or an email code) and authenticates with the JWT it gets back. API keys
// are the server's admin/script credential now.

// Stripe publishable key (pk_test_…), only needed to confirm real Apple Pay
// or card top-ups. Empty is fine — dry run and the mock never reach Stripe.
STRIPE_PUBLISHABLE_KEY =
