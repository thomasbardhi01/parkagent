// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// One ParkNYC block face, geometry buffered one-sided toward its parking lane.
// Loaded from data/out/zones.geojson by `pnpm -C server load:zones`; the table
// always mirrors the most recent load (stale rows are deleted by data_version).
model Zone {
  zoneId             String   @id @map("zone_id")
  // Which city's meter system the zone belongs to: "nyc" | "bos".
  city               String   @default("nyc")
  // The pay-by-app zone number a driver would enter (ParkNYC for nyc rows,
  // ParkBoston for bos rows). "" when unknown: Boston's open data carries
  // none, so bos numbers come from user reports at the meter
  // (POST /zones/:zoneId/provider-number → zone_number_reports).
  providerZoneNumber  String   @map("provider_zone_number")
  // True once two different users reported the same number for this zone.
  providerZoneNumberVerified Boolean @default(false) @map("provider_zone_number_verified")
  // The street the zone is on, as the source data names it (Boston:
  // Analyze Boston's STREET; null for NYC rows until the builder carries
  // one). Evidence, not a gate: session start forwards it into the ParkNYC
  // map cross-check's zoneResolution on the decisions row (non-fatal);
  // Passport has no map, so its rows never get a cross-check.
  street             String?
  // "all" | "commercial" | "charter_bus" | "dual" (see data/build_zones.py)
  vehicleType        String   @map("vehicle_type")
  // True when a private car may park here; the loader filters on this by default.
  passenger          Boolean
  rateFirstHour      Decimal  @map("rate_first_hour") @db.Decimal(6, 2)
  rateAdditionalHour Decimal  @map("rate_additional_hour") @db.Decimal(6, 2)
  maxStayMinutes     Int?     @map("max_stay_minutes")
  // [{"days": ["Mon", ...], "start": "HH:MM", "end": "HH:MM"}]; [] = none posted
  hoursJson          Json     @map("hours_json")
  // Buffered lane polygon: point-in-polygon candidate lookup.
  geom               Unsupported("geometry(MultiPolygon, 4326)")
  // Original face line: rank overlapping candidates by distance to it.
  centerline         Unsupported("geometry(MultiLineString, 4326)")
  // built_at of the zones.geojson this row came from.
  dataVersion        String   @map("data_version")
  loadedAt           DateTime @default(now()) @map("loaded_at") @db.Timestamptz(6)

  @@index([geom], type: Gist)
  @@index([centerline], type: Gist)
  @@map("zones")
}

// One user's report of the pay-by-app number posted at a zone (Boston: the
// open data has none, so drivers read it off the meter). One row per
// (zone, user) — re-reporting updates it; the zone's provider_zone_number
// is the latest report, verified once two different users agree. No FK to
// zones on purpose: zone rows are deleted and re-created on every
// load:zones run and reports must survive that.
model ZoneNumberReport {
  id        String   @id @default(cuid())
  zoneId    String   @map("zone_id")
  userId    String   @map("user_id")
  number    String
  // "user" (typed at the meter) | "scan" (a future meter-sticker scan).
  source    String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([zoneId, userId])
  @@index([zoneId])
  @@map("zone_number_reports")
}

// The two humans this prototype serves. api_key is the whole auth story.
model User {
  id        String   @id @default(cuid())
  name      String
  // Legacy plaintext key: only on rows migrate:api-keys hasn't processed
  // yet; nulled by that script and never written for new users.
  apiKey    String?  @unique @map("api_key")
  // SHA-256(pepper:key) hex — the auth lookup key. Pepper is the
  // API_KEY_PEPPER env secret, so a DB dump alone can't validate keys.
  apiKeyHash String? @unique @map("api_key_hash")
  // First 8 chars of the key, for identification in logs/support only.
  apiKeyPrefix String? @map("api_key_prefix")
  // Gates PUT /policy and /admin/* (403 otherwise). Set at create:user
  // --admin, or by hand in SQL for an existing user.
  isAdmin   Boolean  @default(false) @map("is_admin")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  vehicles     Vehicle[]
  parkedEvents ParkedEvent[]
  sessions     Session[]
  decisions    Decision[]
  deviceTokens DeviceToken[]

  @@map("users")
}

model Vehicle {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  plate     String
  state     String   @default("NY")
  label     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user     User      @relation(fields: [userId], references: [id])
  sessions Session[]

  @@unique([plate, state])
  @@map("vehicles")
}

// Raw phone-detected park, exactly as reported. What the server decided
// about it lives in the linked decisions row, not here.
model ParkedEvent {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  lat       Float
  lng       Float
  // Reported horizontal accuracy, meters.
  accuracyM Float    @map("accuracy_m")
  // When the phone detected the park (device clock).
  ts        DateTime @db.Timestamptz(6)
  // Detector evidence, e.g. ["motion_stop", "bt_disconnect"].
  signals   Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User       @relation(fields: [userId], references: [id])
  decisions Decision[]

  @@map("parked_events")
}

// One ParkNYC paid session. zoneId is a plain string, NOT a relation: the
// zones table mirrors each loader run and stale rows are deleted, so an FK
// would break reloads. For the same reason the zone's terms are snapshotted
// here at start — extensions must price against what the session was sold
// under, not whatever a later data load says.
model Session {
  id                   String    @id @default(cuid())
  userId               String    @map("user_id")
  vehicleId            String?   @map("vehicle_id")
  zoneId               String    @map("zone_id")
  // Which city's meter system the session runs under, from the zone at
  // start ("nyc" | "bos"): the extension worker prices ticket risk and
  // fees per city from this, not from re-reading the zones table.
  city                 String    @default("nyc")
  providerZoneNumber    String    @map("provider_zone_number")
  // pending | active | stopped | expired | failed
  status               String
  dryRun               Boolean   @map("dry_run")
  startedAt            DateTime? @map("started_at") @db.Timestamptz(6)
  expiresAt            DateTime? @map("expires_at") @db.Timestamptz(6)
  stoppedAt            DateTime? @map("stopped_at") @db.Timestamptz(6)
  // Cumulative meter + fee dollars across the start and every extension.
  amountUsd            Decimal?  @map("amount_usd") @db.Decimal(6, 2)
  feeUsd               Decimal?  @map("fee_usd") @db.Decimal(6, 2)
  parknycConfirmation  String?   @map("parknyc_confirmation")
  // "issuing_card" (default) | "link_wallet" — which source pays this
  // session. link_wallet requires a valid (unexpired, unused) one-time
  // card from an approved Link spend request; expiry falls back to
  // issuing_card and tells the user.
  paymentSource        String    @default("issuing_card") @map("payment_source")
  // The parked_events row this session came from (plain string, no FK churn).
  parkedEventId        String?   @map("parked_event_id")
  // Where the car is: the parked event's fix, the anchor for distance-to-car.
  carLat               Float?    @map("car_lat")
  carLng               Float?    @map("car_lng")
  // Zone terms snapshot at start.
  rateFirstHour        Decimal?  @map("rate_first_hour") @db.Decimal(6, 2)
  rateAdditionalHour   Decimal?  @map("rate_additional_hour") @db.Decimal(6, 2)
  maxStayMinutes       Int?      @map("max_stay_minutes")
  hoursJson            Json?     @map("hours_json")
  // Wall-clock minutes bought and the subset that was inside enforcement
  // hours (the ladder consumes charged minutes; extensions continue it).
  purchasedMinutes     Int       @default(0) @map("purchased_minutes")
  chargedMinutes       Int       @default(0) @map("charged_minutes")
  extendCount          Int       @default(0) @map("extend_count")
  // Extender hysteresis: the last rule the tick worker settled on and when
  // it changed; a different rule within 5 minutes is held, not acted on.
  lastExtenderRule     String?   @map("last_extender_rule")
  lastExtenderRuleAt   DateTime? @map("last_extender_rule_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User          @relation(fields: [userId], references: [id])
  vehicle      Vehicle?      @relation(fields: [vehicleId], references: [id])
  decisions    Decision[]
  events       SessionEvent[]
  locationFixes LocationFix[]

  @@index([userId, createdAt])
  @@index([status])
  @@map("sessions")
}

// Append-only ledger of what actually happened to a session: every executor
// call and lifecycle transition, with the money it moved.
model SessionEvent {
  id                String   @id @default(cuid())
  sessionId         String   @map("session_id")
  // started | extended | stopped | expired | failed
  kind              String
  at                DateTime @db.Timestamptz(6)
  minutes           Int?
  amountUsd         Decimal? @map("amount_usd") @db.Decimal(6, 2)
  feeUsd            Decimal? @map("fee_usd") @db.Decimal(6, 2)
  expiresAt         DateTime? @map("expires_at") @db.Timestamptz(6)
  providerSessionId String?  @map("provider_session_id")
  dryRun            Boolean  @map("dry_run")
  // Free-form context: executor error codes, auto vs manual, etc.
  details           Json?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  session Session @relation(fields: [sessionId], references: [id])

  @@index([sessionId, at])
  @@map("session_events")
}

// Phone fixes reported while a session is active — the extension worker's
// view of where the driver is relative to the car.
model LocationFix {
  id        String   @id @default(cuid())
  sessionId String   @map("session_id")
  userId    String   @map("user_id")
  lat       Float
  lng       Float
  accuracyM Float    @map("accuracy_m")
  ts        DateTime @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  session Session @relation(fields: [sessionId], references: [id])

  @@index([sessionId, ts])
  @@map("location_fixes")
}

// APNs device tokens registered via POST /device. The app re-sends on every
// launch, so rows are upserted by token; a 410 from Apple deletes the row.
model DeviceToken {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  // Bound to its user (409 on cross-user rebind); cascades on deletion.
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token       String   @unique
  platform    String
  // "development" (sandbox APNs host) | "production"
  environment String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("device_tokens")
}

// A chained link → setup-card job the app polls (GET
// /providers/:provider/link-status). Durable so a deploy or machine stop
// mid-job doesn't lose the answer; a janitor times out rows stuck
// in-progress past 15 minutes.
model LinkJob {
  id        String   @id
  userId    String   @map("user_id")
  provider  String
  // linking | adding_card | done | failed
  phase     String
  // Typed failure reason (executor code, "no_card", or "timeout").
  reason    String?
  retrySafe Boolean? @map("retry_safe")
  dryRun    Boolean? @map("dry_run")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([phase, createdAt])
  @@map("link_jobs")
}

// Idempotency ledger for Apple Pay top-ups: one row per
// payment_intent.succeeded whose amount was moved onto the financial
// account. Stripe redelivers events; a second delivery finds the row and
// skips the move instead of doubling it.
model ProcessedTopup {
  paymentIntentId String   @id @map("payment_intent_id")
  amountUsd       Decimal  @map("amount_usd") @db.Decimal(8, 2)
  userId          String?  @map("user_id")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("processed_topups")
}

// One assistant conversation per (user, conversation id): the model's
// message history (last 20 turns, JSON in the Messages-API shape) so the
// dialogue survives app restarts. Old conversations are just rows — no
// janitor needed at two users.
model Conversation {
  id        String   @id
  userId    String   @map("user_id")
  // [{role, content}] — Anthropic Messages shape, trimmed to 20 turns.
  turns     Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId, updatedAt])
  @@map("conversations")
}

// A plan the assistant proposed and the client rendered. Confirmation
// tokens are minted ONLY when the user taps Confirm/Sign off on one of
// these — the token is single-use, short-lived, and bound to this plan.
model AssistantPlan {
  id        String    @id
  userId    String    @map("user_id")
  conversationId String @map("conversation_id")
  // "single_spot" | "itinerary"
  kind      String
  // The structured plan exactly as proposed (options / stops / totals).
  plan      Json
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt])
  @@map("assistant_plans")
}

// Single-use sign-off token: minted by POST /assistant/confirm (the
// user's tap), consumed by the booking/session tool it authorizes.
// Nothing books or spends without one — tools enforce it.
model AssistantConfirmation {
  token     String   @id
  userId    String   @map("user_id")
  planId    String   @map("plan_id")
  // Which option/stop of the plan this tap authorized (null = whole plan).
  optionId  String?  @map("option_id")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt])
  @@map("assistant_confirmations")
}

// A signed-off multi-stop day. Stops are a JSON array (address, arrival,
// duration, choice street|garage, costs, linkage to sessions / garage
// deep links); totals are checked against the daily cap at sign-off and
// on every PATCH.
model Itinerary {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  planId    String?  @map("plan_id")
  // draft | signed_off | done | canceled
  status    String
  date      DateTime @db.Timestamptz(6)
  stops     Json
  totalUsd  Decimal  @map("total_usd") @db.Decimal(8, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId, date])
  @@map("itineraries")
}

// The user's connected Link wallet (Stripe agentic commerce). Tokens are
// sealed with the same AES-256-GCM StateCrypto as provider cookies;
// access token 1 h, refresh token 1 y rotated on every use.
model LinkAccount {
  userId       String   @id @map("user_id")
  // connected | disconnected
  status       String
  // Sealed JSON {accessToken, refreshToken, expiresAt, scope}.
  tokensEncrypted String? @map("tokens_encrypted")
  connectedAt  DateTime? @map("connected_at") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("link_accounts")
}

// One Link spend request per paid stop (verified: the Link API has no
// batch approval — each request carries one amount + one merchant).
// The one-time virtual card is sealed once approved; valid_until is 12 h
// from creation, after which pay time falls back to the Issuing card.
model LinkSpendRequest {
  id           String   @id            // lsrq_…
  userId       String   @map("user_id")
  itineraryId  String?  @map("itinerary_id")
  stopId       String?  @map("stop_id")
  planId       String?  @map("plan_id")
  amountUsd    Decimal  @map("amount_usd") @db.Decimal(8, 2)
  // created | pending_approval | requires_action | approved | denied |
  // expired | canceled | succeeded | failed  (Link's own vocabulary)
  status       String
  approvalUrl  String?  @map("approval_url")
  // Sealed one-time card {number, cvc, expMonth, expYear, brand}.
  cardEncrypted String? @map("card_encrypted")
  validUntil   DateTime? @map("valid_until") @db.Timestamptz(6)
  cardUsedAt   DateTime? @map("card_used_at") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId, createdAt])
  @@map("link_spend_requests")
}

// Non-negotiable: every automated decision writes a row here with its inputs.
model Decision {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  // What kind of decision, e.g. "parked_quote".
  kind          String
  // Everything the rule saw: request body, candidates, policy hash, dry run.
  inputs        Json
  // The rule that fired, e.g. "auto_pay_ok", "candidates_disagree".
  rule          String
  // What came of it: action, quote, zone.
  outcome       Json
  userId        String?  @map("user_id")
  parkedEventId String?  @map("parked_event_id")
  sessionId     String?  @map("session_id")

  user        User?        @relation(fields: [userId], references: [id])
  parkedEvent ParkedEvent? @relation(fields: [parkedEventId], references: [id])
  session     Session?     @relation(fields: [sessionId], references: [id])

  @@index([createdAt])
  @@map("decisions")
}

// Every distinct policy.json the server has run with or accepted via PUT.
model PolicySnapshot {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  // sha256 of the canonical (sorted-keys) JSON.
  hash      String
  policy    Json
  // "boot" | "put"
  source    String

  @@index([hash])
  @@map("policy_snapshots")
}

// ---- Phase 6: Stripe Issuing (test mode) ----
// Card numbers never land here — Stripe IDs only (non-negotiable).
// userId is a plain string, NOT a relation: keeps this branch's schema
// additions self-contained while feat/sessions-extension edits User in
// parallel. Revisit after the merge if a real FK is wanted.

// One Stripe Issuing cardholder per user, created by `pnpm -C server issuing:setup`.
model IssuingCardholder {
  id                 String   @id @default(cuid())
  userId             String   @unique @map("user_id")
  stripeCardholderId String   @unique @map("stripe_cardholder_id")
  name               String
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  cards IssuingCard[]

  @@map("issuing_cardholders")
}

// One virtual card per cardholder. The spending controls live on the Stripe
// card object; the caps are mirrored here so an audit doesn't need an API call.
model IssuingCard {
  id            String   @id @default(cuid())
  cardholderId  String   @map("cardholder_id")
  stripeCardId  String   @unique @map("stripe_card_id")
  last4         String
  // active | inactive | canceled (mirrors Stripe)
  status        String
  // Controls set at create/last setup run, from policy.json at that moment.
  perAuthCapUsd Decimal  @map("per_auth_cap_usd") @db.Decimal(6, 2)
  dailyCapUsd   Decimal  @map("daily_cap_usd") @db.Decimal(6, 2)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  cardholder IssuingCardholder @relation(fields: [cardholderId], references: [id])

  @@map("issuing_cards")
}

// Every issuing_authorization Stripe tells us about, with the decision our
// webhook made on the .request event. The linked decisions row carries the
// full inputs; this table is the card-spend ledger the daily budget sums.
model IssuingAuthorization {
  id                    String   @id @default(cuid())
  stripeAuthorizationId String   @unique @map("stripe_authorization_id")
  stripeCardId          String   @map("stripe_card_id")
  // Resolved from the card at decision time; null when the card is unknown.
  userId                String?  @map("user_id")
  amountUsd             Decimal  @map("amount_usd") @db.Decimal(8, 2)
  // Stripe MCC name and code, e.g. "parking_lots_garages" / "7523".
  merchantCategory      String?  @map("merchant_category")
  merchantCategoryCode  String?  @map("merchant_category_code")
  merchantName          String?  @map("merchant_name")
  approved              Boolean
  // approved | declined_* (see services/issuing.ts) | external (first seen
  // via a created/updated event, i.e. not decided by our webhook)
  decision              String
  // Stripe lifecycle: pending | closed | reversed
  status                String
  // Filled by issuing_transaction.created; the ledger's settled leg.
  stripeTransactionId   String?  @unique @map("stripe_transaction_id")
  capturedUsd           Decimal? @map("captured_usd") @db.Decimal(8, 2)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId, createdAt])
  @@map("issuing_authorizations")
}

// ---- Provider accounts ----
// One row per (user, parking provider): the user's own linked account at
// ParkNYC etc., replacing the single-secret executor auth. The session
// state (cookies from the app's login web view) is sealed with AES-256-GCM
// under PROVIDER_STATE_KEY — never logged, never returned by any endpoint.
// userId is a plain string like the Issuing tables (no FK churn).
model ProviderAccount {
  id                 String    @id @default(cuid())
  userId             String    @map("user_id")
  // Registry id, e.g. "parknyc" (see src/providers/registry.ts).
  provider           String
  // linked | expired (re-link needed) | unlinked
  status             String
  // AES-256-GCM sealed Playwright storage state (base64 iv|tag|ciphertext).
  stateEncrypted     String?   @map("state_encrypted")
  linkedAt           DateTime? @map("linked_at") @db.Timestamptz(6)
  lastVerifiedAt     DateTime? @map("last_verified_at") @db.Timestamptz(6)
  // Our Issuing card is the provider account's payment method.
  cardAdded          Boolean   @default(false) @map("card_added")
  // Provider wallet balance as last seen (null: provider has no wallet or
  // we could not read it).
  walletBalanceCents Int?      @map("wallet_balance_cents")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([userId, provider])
  @@map("provider_accounts")
}

// Audit row per loader run.
model ZoneLoad {
  id             Int      @id @default(autoincrement())
  loadedAt       DateTime @default(now()) @map("loaded_at") @db.Timestamptz(6)
  // Which city this load mirrored ("nyc" | "bos"); loads are per-city.
  city           String   @default("nyc")
  dataVersion    String   @map("data_version")
  // Socrata dataset ids the build consumed, e.g. {"block_faces": "e7yp-wx55"}.
  sourceDatasets Json     @map("source_datasets")
  zoneCount      Int      @map("zone_count")
  passengerOnly  Boolean  @map("passenger_only")

  @@map("zone_loads")
}
