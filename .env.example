DATABASE_URL=postgresql://user:pass@your-neon-host/parkagent?sslmode=require
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Optional: the financial account the Issuing cards draw from (fa_…).
# Discovered from an existing card when unset.
# STRIPE_FINANCIAL_ACCOUNT=fa_replace_me
# Optional: Global Payouts recipient for POST /card/funding/withdraw.
# Unset → withdrawals answer funding_unavailable.
# STRIPE_PAYOUT_RECIPIENT=acct_replace_me
SOCRATA_APP_TOKEN=replace_me
# Contents of the APNs .p8 auth key. In .env, quote it and use \n for the
# line breaks; on Fly: fly secrets set -a parkagent-api APNS_KEY="$(cat AuthKey_XXXXXXXXXX.p8)"
APNS_KEY="-----BEGIN PRIVATE KEY-----\nreplace_me\n-----END PRIVATE KEY-----"
APNS_KEY_ID=replace_me
APNS_TEAM_ID=replace_me
APNS_BUNDLE_ID=com.yourname.parkagent
DRY_RUN=true
# Seals linked provider session state (provider_accounts.state_encrypted).
# Generate:  openssl rand -base64 32
# On Fly:    fly secrets set -a parkagent-api PROVIDER_STATE_KEY="$(openssl rand -base64 32)"
# Unset → provider linking answers 503 and real executor calls fail typed.
#PROVIDER_STATE_KEY=replace_me_32_bytes_base64
# Plate to park when a session doesn't name one (else ParkNYC's first saved
# vehicle is used).
#PARKNYC_PLATE=ABC1234
# Optional: where executor unexpected-screen evidence is also written as files.
#EXECUTOR_CAPTURE_DIR=/tmp/parkagent-captures
# Optional: LLM recovery hook for unexpected ParkNYC screens (stubbed, off).
#EXECUTOR_LLM_RECOVERY=false
