%% ParkAgent: phone → routes → services → providers.
%% Rows and file:line anchors are in docs/feature-map.md.
%% Every start, extension, stop, prompt, quote, assistant confirm and
%% funding move asks the one money gate (services/moneyGate.ts) with who
%% is acting (Principal); an extension asks again under its lock.
%% Every path id is parsed before the database (routes/ids.ts), and a NUL
%% that reaches Postgres anyway answers 400 (services/pgErrors.ts).
flowchart LR
  subgraph phone["Phone (ios/ParkAgent)"]
    detector["ParkDetector + ParkFusionEngine"]
    classifier["PlaceClassifier + FootprintIndex"]
    lifecycle["ParkLifecycle + LocationReporter"]
    outbox["ParkOutbox"]
    assistantUI["Assistant sheet"]
    walletUI["Wallet tab"]
    sessionUI["Active session card"]
    linkUI["Provider link web view"]
  end

  subgraph routes["Routes (server/src/routes)"]
    parked["POST /parked"]
    signsR["POST /parked/:id/signs<br/>(SIGN_READER, off by default)"]
    location["POST /location"]
    confirm["POST /parked/:id/confirm"]
    decline["POST /parked/:id/decline"]
    sessStart["POST /session/start"]
    sessExtend["POST /session/extend"]
    sessStop["POST /session/stop"]
    asst["POST /assistant/message · /assistant/confirm"]
    garagesR["GET /garages/near"]
    walletR["/wallet · /card · /link"]
    providersR["POST /providers/:provider/link"]
    webhook["POST /webhooks/stripe"]
    traceR["GET /admin/parks/:id/trace (admin)"]
    auditR["GET /admin/audit (admin)"]
    agentR["/agent/* (REST, Bearer pak_)<br/>GET /agent/openapi.json (OpenAPI 3.1)"]
    mcpR["/mcp (MCP 2026-07-28, Bearer pak_)<br/>seven tools, annotated · plan and park resources"]
    mcpCard["ui://parkagent/confirm-card<br/>(MCP_APPS, off by default)"]
  end

  agents(["External agents<br/>Grok · Claude · any MCP client"])

  subgraph services["Services and jobs (server/src)"]
    zoneLookup["zoneLookup + quote + placeClassification"]
    pending["pendingSession (rules)<br/>advanceWalk · mayBeAtTheDoor (door rule) · movePark<br/>phonePosition: the one reader of where the phone is"]
    gate{{"MONEY GATE · services/moneyGate<br/>agent consent first · fails closed: amount_invalid · minutes_invalid<br/>usable provider account (start, prompt, extend) · caps (policyFor + spentToday, receipt excess on top)<br/>max stay (the accepted sign stay) · dry run · as shown (quote/zone/dry run)<br/>auto extend: not needs_review; under the lock, phone away + no newer park<br/>CAS before it: parked.ts confirm · location.ts walk-away<br/>one open session: unique index"}}
    applyExt["applyExtension<br/>advisory lock · asks the gate again on the fresh row (withAcceptedStay)"]
    extendTick["jobs/extendTick (60 s)<br/>only while phonePosition says away<br/>account not usable: Reconnect push"]
    holds["wallet/holds<br/>hold → settle"]
    issuing["issuing.decideAuthorization<br/>daily cap · hold claim"]
    linkWallet["link/linkWallet<br/>spend request (garages only)"]
    linkWorker["jobs/linkWorker"]
    healthTick["jobs/providerHealthTick"]
    ledger[("decisions ledger")]
    parkFixes[("park_fixes<br/>every fix a park read or refused · 30 days")]
    parkTrace["parkTrace<br/>trace → anonymized fixture"]
    retention["jobs/conversationRetentionTick<br/>(hourly retention sweep)"]
    audit["audit invariants + summary<br/>report-only · Haiku behind AUDIT_SUMMARY, template otherwise"]
    explain["capabilities/explainDecision<br/>reasons.ts: what · evidence · what you can do<br/>EXPLAIN_MODEL phrasing (off by default) · template fallback"]
    execGate["ExecutorGate + CircuitBreaker<br/>DRY_RUN → DryRunExecutor"]
    agentActions["agentActions + mandates<br/>one call, two surfaces · one budget per key"]
    otel["telemetry (OpenTelemetry)<br/>off unless OTEL_EXPORTER_OTLP_ENDPOINT · no words in spans"]
  end

  subgraph providers["Providers"]
    passport["executor/src/passport (ParkBoston)"]
    parknyc["executor/src/parknyc (ParkNYC)"]
    stripe["Stripe (holds, Issuing)"]
    stripeLink["Stripe Link"]
    garagesExt["SpotHero · ParkWhiz (read-only)"]
  end

  detector --> classifier --> parked
  outbox -. "offline, Idempotency-Key" .-> parked
  lifecycle --> location
  lifecycle --> confirm
  lifecycle --> decline
  classifier --> garagesR
  sessionUI --> sessExtend
  sessionUI --> sessStop
  assistantUI --> asst
  walletUI --> walletR
  linkUI --> providersR

  parked --> zoneLookup
  signsR --> readSigns["readSigns<br/>Sonnet 5.5 · strict SignRules · grounded"]
  readSigns -. "advisory: warn, or a shorter stay on accept" .-> parked
  readSigns --> ledger
  parked --> pending
  location --> pending
  confirm --> pending
  pending -- "startParkSession → start" --> gate
  sessStart -- "start" --> gate
  asst -. "street plan: start_via_app, pays nothing" .-> lifecycle
  asst -- "garage plan" --> linkWallet --> stripeLink
  asst --> garagesExt

  gate --> holds --> stripe
  gate --> execGate
  sessExtend -- "extend" --> gate
  extendTick -- "extend (job)" --> gate
  gate --> applyExt
  applyExt --> holds
  applyExt --> execGate
  sessStop -- "stop: consent only" --> gate
  location -. "return / drive-off: endSession" .-> execGate
  execGate --> passport
  execGate --> parknyc
  stripe --> webhook --> issuing --> holds

  providersR --> linkWorker --> execGate
  healthTick --> execGate

  gate --> ledger
  routes -. "request spans" .-> otel
  asst -. "invoke_agent · chat · execute_tool" .-> otel
  gate -. "money_gate span" .-> otel
  explain & audit & readSigns -. "chat span per model call" .-> otel
  otel -. "trace_id" .-> ledger
  applyExt --> ledger
  pending --> ledger
  asst -. "explain_decision" .-> explain
  explain -. "reads one row (owner or admin)" .-> ledger

  location -- "each fix, read or refused (why)" --> parkFixes
  traceR --> parkTrace
  parkTrace --> parkFixes
  parkTrace --> ledger
  parkTrace -. "trace:export → test/traces/*.json → trace:replay" .-> pending
  retention -. "deletes after 30 days" .-> parkFixes
  auditR --> audit
  audit -. "reads" .-> ledger
  audit -. "reads" .-> parkFixes
  audit -. "reads sessions, pending_parks" .-> pending
  nightly(["nightly-fr workflow"]) -- "yesterday's audit → one 'Nightly audit' issue" --> auditR
  agents --> agentR
  agents --> mcpR
  mcpR -. "propose_plan _meta.ui" .-> mcpCard
  agentR --> agentActions
  mcpR --> agentActions
  agentActions -- "confirm: consent · mandate · caps" --> gate
  agentActions -. "street: pending_arrival, pays nothing; arrival only from the phone" .-> lifecycle
  agentActions -- "confirm: consume the mandate · mark the plan confirmed" --> plans[("assistant_plans · mandates<br/>token hashed · one use · 10 min")]
  parked -- "E3: the next park at a park_now plan's zone, consent still on: bind once, held confirmed" --> plans
  signsR -. "accept: a shorter max stay, never longer, never below what was paid" .-> applyExt
  ids["routes/ids.ts<br/>recordId on every path id but :provider"] -. "400 before the database" .-> routes
  agentActions --> ledger
  agentActions -. "why · explain_decision" .-> explain

  subgraph pp["pending_parks state machine (server/src/services/pendingSession.ts)"]
    direction TB
    at_car(["at_car"])
    prompted(["prompted"])
    confirmed(["confirmed"])
    starting(["starting"])
    started(["started"])
    ended(["ended"])
    free(["free"])
    start_failed(["start_failed"])
    declined(["declined"])
    cancelled(["cancelled"])
    superseded(["superseded"])
    covered(["covered"])
    expired(["expired"])

    at_car -- "phone left: two fixes clear at a walk, or left_car off the door" --> prompted
    at_car -- "tap at the car (waits for the walk-away)" --> confirmed
    prompted -- "tap back at the car" --> confirmed
    prompted -- "tap away: CAS → starting" --> starting
    confirmed -- "left_car off the door: CAS → starting" --> starting
    confirmed -- "pace only, or fix_away after a left_car refused at the door: asked again" --> prompted
    starting -- "refused before the provider" --> prompted
    starting -- "start ok (via the money gate)" --> started
    starting -- "failed at the provider, or no answer in time" --> start_failed
    starting -- "quote now $0" --> free
    started -- "back at the car 60 s, returned_to_car, or drive-off" --> ended
    at_car -- "returned or drove off before paying" --> cancelled
    prompted -- "Not now · Wrong spot" --> declined
    at_car -- "a newer /parked (confirmed, prompted too)" --> superseded
    prompted -- "a running session already covers it" --> covered
    prompted -- "no tap in time (at_car, confirmed: 60 min)" --> expired
    started -- "a newer park > 100 m away: car_moved_at, no more extensions" --> started
  end

  pending -. "applies" .-> pp
