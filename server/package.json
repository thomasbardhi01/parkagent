{
  "name": "server",
  "version": "1.0.0",
  "description": "ParkAgent API: Fastify + TypeScript on Fly.io",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:fr": "vitest run --config vitest.fr.config.ts",
    "test:pg": "vitest run --config test/pg/vitest.config.ts",
    "lint": "eslint src",
    "create:fr-user": "tsx src/scripts/create-fr-user.ts",
    "load:zones": "tsx src/scripts/load-zones.ts",
    "agent:tools": "tsx src/scripts/agent-tools.ts",
    "explain:eval": "tsx src/scripts/explain-eval.ts",
    "load:garages": "tsx src/scripts/load-garages.ts",
    "create:user": "tsx src/scripts/create-user.ts",
    "decisions:recent": "tsx src/scripts/recent-decisions.ts",
    "trace:export": "tsx src/scripts/trace-export.ts",
    "trace:replay": "tsx test/traces/replay-cli.ts",
    "audit:eval-live": "tsx test/audit/eval-live.ts",
    "issuing:setup": "tsx src/scripts/issuing-setup.ts",
    "stripe:trigger": "tsx src/scripts/stripe-trigger.ts",
    "migrate:api-keys": "tsx src/scripts/migrate-api-keys.ts",
    "migrate:policy-fee": "tsx src/scripts/migrate-policy-fee.ts",
    "attach-identity": "tsx src/scripts/attach-identity.ts",
    "check-secrets": "tsx src/scripts/check-secrets.ts",
    "create:fr-throwaway": "tsx src/scripts/create-fr-throwaway.ts",
    "purge:fr-throwaways": "tsx src/scripts/purge-fr-throwaways.ts",
    "load:zone-numbers": "tsx src/scripts/load-zone-numbers.ts",
    "sign:eval": "tsx src/scripts/sign-eval.ts",
    "verify:garages": "tsx src/scripts/verify-garages.ts",
    "verify:places": "tsx src/scripts/verify-places.ts"
  },
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@fastify/cors": "^11.3.1",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^18.0.8",
    "executor": "workspace:*",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "prisma": "7.10.0",
    "stripe": "^22.6.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  },
  "private": true
}
